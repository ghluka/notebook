# Copy to .env. Every value here has a working default, so the file is optional.
BIND_ADDR=127.0.0.1:8080
DATABASE_URL=sqlite://data.db
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=268435456

# Set this when a reverse proxy serves the app from a subdirectory, so the
# URLs it emits carry the prefix. See the reverse proxy section of README.md.
# BASE_PATH=/notebook

# RUST_LOG=notebook=debug,tower_http=debug
